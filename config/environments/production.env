# Purple Team GPT - Production Environment
# IMPORTANT: This is a template. DO NOT commit actual production values!

# Application
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=WARNING
# APP_SECRET_KEY=<inject-from-secrets-manager>

# CORS - Restrictive origins only
CORS_ORIGINS=https://purpleteam-gpt.example.com

# LLM
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o
LLM_TEMPERATURE=0.5
LLM_ENABLE_FAILOVER=true

# ChromaDB - Remote instance
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_ALLOW_RESET=false
# CHROMA_AUTH_TOKEN=<inject-from-secrets-manager>

# Redis - Remote instance with auth
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=<inject-from-secrets-manager>

# Agent - Strict security
AGENT_SAFE_MODE=true
AGENT_AUTO_CONFIRM=false
AGENT_MAX_STEPS=30

# Frontend - Production URLs
# VITE_API_URL=<inject-at-build-time>
# VITE_WS_URL=<inject-at-build-time>