# Purple Team GPT - Development Environment
# Used for local development

# Application
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_SECRET_KEY=dev-secret-key-not-for-production-use

# CORS - Allow all local development origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# LLM - Use local Ollama by default
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o
LLM_TEMPERATURE=0.7

# ChromaDB - Local instance
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_ALLOW_RESET=true

# Redis - Local instance
REDIS_HOST=localhost
REDIS_PORT=6379

# Agent - More permissive for development
AGENT_SAFE_MODE=false
AGENT_AUTO_CONFIRM=true

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000