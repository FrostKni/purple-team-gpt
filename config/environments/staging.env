# Purple Team GPT - Staging Environment
# Pre-production testing environment

# Application
APP_ENV=staging
APP_DEBUG=false
APP_LOG_LEVEL=INFO
# APP_SECRET_KEY=<inject-from-secrets-manager>

# CORS
CORS_ORIGINS=https://staging.purpleteam-gpt.example.com

# LLM - Use same as production for realistic testing
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.5

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_ALLOW_RESET=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Agent
AGENT_SAFE_MODE=true
AGENT_AUTO_CONFIRM=false

# Frontend
# VITE_API_URL=<inject-at-build-time>
# VITE_WS_URL=<inject-at-build-time>