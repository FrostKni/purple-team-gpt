# Purple Team GPT - Environment Configuration
# Copy this file to .env and configure your settings
# NEVER commit the actual .env file to version control

# ===========================================
# Application Settings
# ===========================================
# Environment: development, staging, production
APP_ENV=development

# Debug mode (MUST be false in production!)
APP_DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
APP_LOG_LEVEL=DEBUG

# Secret key for JWT signing (REQUIRED in production)
# SECURITY: Generate with: ./scripts/generate-secrets.sh
# Minimum 64 characters for production
# Never use the default value in production!
APP_SECRET_KEY=your-secret-key-change-me-in-production-min-64-chars

# JWT settings
APP_JWT_ALGORITHM=HS256
APP_JWT_EXPIRE_MINUTES=60

# Rate limiting
APP_RATE_LIMIT_REQUESTS=100
APP_RATE_LIMIT_WINDOW_SECONDS=60

# Server settings
APP_HOST=0.0.0.0
APP_PORT=8000

# ===========================================
# Domain Configuration (Production)
# ===========================================
# Your domain name for SSL certificates
# DOMAIN=example.com

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins
# For production, use your actual domain:
# CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ===========================================
# LLM Provider Configuration
# ===========================================
# Choose your default provider: openai, anthropic, groq, ollama, deepseek, mistral, openai_compatible
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o

# Generation parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_ENABLE_FAILOVER=true

# ===========================================
# LLM Provider API Keys
# SECURITY: Store these securely!
# See docs/SECRETS_MANAGEMENT.md for best practices
# ===========================================
# Set the ones you want to use
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_GROQ_API_KEY=
LLM_DEEPSEEK_API_KEY=
LLM_MISTRAL_API_KEY=

# Ollama configuration (local LLM)
LLM_OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# OpenAI-Compatible Endpoints
# ===========================================
# Use this for any OpenAI-compatible API
LLM_OPENAI_COMPATIBLE_API_KEY=
LLM_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
LLM_OPENAI_COMPATIBLE_MODEL=llama3.2

# ===========================================
# Database Configuration
# SECURITY: Use strong passwords in production!
# Generate with: ./scripts/generate-secrets.sh
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=purple_team_gpt
DB_USER=postgres
DB_PASSWORD=change-me-in-production

# Connection pooling (production)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600

# ===========================================
# Redis Configuration
# SECURITY: Enable password in production!
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis password (required for production)
# REDIS_PASSWORD=your-redis-password

# ===========================================
# ChromaDB Configuration
# ===========================================
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_ALLOW_RESET=true
# Optional: Authentication token for ChromaDB
# CHROMA_AUTH_TOKEN=your-chroma-token

# ===========================================
# Agent Configuration
# ===========================================
AGENT_MAX_STEPS=50
AGENT_TIMEOUT=300
AGENT_SAFE_MODE=true
AGENT_AUTO_CONFIRM=false

# ===========================================
# Frontend Configuration
# ===========================================
# API URL for frontend to connect to backend
# For production with SSL:
# VITE_API_URL=https://your-domain.com
# VITE_WS_URL=wss://your-domain.com
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ===========================================
# Docker Ports (for docker-compose)
# ===========================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
CHROMA_PORT=8001
REDIS_PORT=6379
OLLAMA_PORT=11434

# ===========================================
# SSL/TLS Configuration
# ===========================================
# For local development with self-signed certs:
# ./scripts/setup-ssl.sh

# For production with Let's Encrypt:
# ./scripts/setup-letsencrypt.sh -d your-domain.com -e admin@your-domain.com

# ===========================================
# SECRETS MANAGEMENT GUIDANCE
# ===========================================
#
# PRODUCTION DEPLOYMENT REQUIREMENTS:
# ----------------------------------
# 1. ALL secrets must be changed from defaults
# 2. Use a secrets manager (recommended):
#    - HashiCorp Vault
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - Google Secret Manager
#
# 3. Generate secrets using:
#    ./scripts/generate-secrets.sh -o .env.production
#
# 4. Set file permissions:
#    chmod 600 .env.production
#
# 5. Add to .gitignore:
#    .env
#    .env.local
#    .env.*.local
#    secrets/
#
# DOCKER SECRETS:
# ---------------
# Use Docker secrets for sensitive data:
#   echo "your-secret" | docker secret create app_secret_key -
# Reference in compose:
#   secrets:
#     - app_secret_key
#
# Create secret files:
#   mkdir -p secrets
#   echo "your-app-secret" > secrets/app_secret_key.txt
#   echo "your-db-password" > secrets/db_password.txt
#   chmod 600 secrets/*.txt
#
# KUBERNETES:
# -----------
# Use Kubernetes Secrets:
#   kubectl create secret generic purple-team-secrets \
#     --from-literal=app-secret-key=your-key \
#     --from-literal=db-password=your-password
#
# CI/CD (GitHub Actions):
# -----------------------
# Store secrets in repository settings:
#   Settings -> Secrets and variables -> Actions -> New repository secret
#
# SECRET ROTATION:
# ----------------
# - Application secrets: Every 90 days
# - Database passwords: Every 90 days
# - API keys: On compromise or annually
# - Use: ./scripts/generate-secrets.sh to generate new secrets
#
# SECURITY CHECKLIST:
# -------------------
# [ ] All secrets changed from defaults
# [ ] .env files in .gitignore
# [ ] File permissions set to 600
# [ ] Secrets stored in secrets manager
# [ ] Different secrets per environment
# [ ] Rotation schedule documented
# [ ] Audit logging enabled
#
# VALIDATION:
# -----------
# Ensure APP_SECRET_KEY is at least 64 characters
# Ensure all API keys are valid before deployment
# Test with: python -c "from purple_team_gpt.config import get_settings; print(get_settings())"
#
# For detailed documentation, see: docs/SECRETS_MANAGEMENT.md