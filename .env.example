# Purple Team GPT - Environment Configuration
# Copy this file to .env and configure your settings

# ===========================================
# Application Settings
# ===========================================
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-to-a-secure-random-string

# ===========================================
# LLM Provider Configuration
# ===========================================
# Choose your default provider: openai, anthropic, groq, ollama, deepseek, mistral, openai_compatible
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o

# Generation parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_ENABLE_FAILOVER=true

# ===========================================
# Standard LLM Provider API Keys
# ===========================================
# Set the ones you want to use
LLM_OPENAI_API_KEY=your-openai-api-key-here
LLM_ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_GROQ_API_KEY=your-groq-api-key-here
LLM_DEEPSEEK_API_KEY=your-deepseek-api-key-here
LLM_MISTRAL_API_KEY=your-mistral-api-key-here

# Ollama configuration (local LLM)
LLM_OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# OpenAI-Compatible Endpoints
# ===========================================
# Use this for any OpenAI-compatible API (OpenRouter, LocalAI, vLLM, LMStudio, etc.)
# Set these to use a custom OpenAI-compatible endpoint as your provider

# Single endpoint via environment variables:
LLM_OPENAI_COMPATIBLE_API_KEY=your-api-key-or-local
LLM_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
LLM_OPENAI_COMPATIBLE_MODEL=llama3.2

# Then set LLM_DEFAULT_PROVIDER=openai_compatible to use it

# ===========================================
# Popular OpenAI-Compatible Services Examples
# ===========================================

# OpenRouter (https://openrouter.ai)
# LLM_OPENAI_COMPATIBLE_API_KEY=your-openrouter-key
# LLM_OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENAI_COMPATIBLE_MODEL=openai/gpt-4o

# Together AI (https://together.ai)
# LLM_OPENAI_COMPATIBLE_API_KEY=your-together-key
# LLM_OPENAI_COMPATIBLE_BASE_URL=https://api.together.xyz/v1
# LLM_OPENAI_COMPATIBLE_MODEL=meta-llama/Llama-3-70b-chat-hf

# LocalAI
# LLM_OPENAI_COMPATIBLE_API_KEY=your-api-key
# LLM_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1
# LLM_OPENAI_COMPATIBLE_MODEL=gpt-3.5-turbo

# vLLM
# LLM_OPENAI_COMPATIBLE_API_KEY=EMPTY
# LLM_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# LLM_OPENAI_COMPATIBLE_MODEL=meta-llama/Llama-3-8b-chat-hf

# LM Studio
# LLM_OPENAI_COMPATIBLE_API_KEY=lm-studio
# LLM_OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
# LLM_OPENAI_COMPATIBLE_MODEL=local-model

# Ollama (OpenAI-compatible mode)
# LLM_OPENAI_COMPATIBLE_API_KEY=ollama
# LLM_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# LLM_OPENAI_COMPATIBLE_MODEL=llama3.2

# Azure OpenAI
# LLM_OPENAI_COMPATIBLE_API_KEY=your-azure-key
# LLM_OPENAI_COMPATIBLE_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# LLM_OPENAI_COMPATIBLE_MODEL=gpt-4o

# ===========================================
# ChromaDB Configuration
# ===========================================
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chromadb

# ===========================================
# Agent Configuration
# ===========================================
AGENT_MAX_STEPS=50
AGENT_TIMEOUT=300
AGENT_SAFE_MODE=true
AGENT_AUTO_CONFIRM=false